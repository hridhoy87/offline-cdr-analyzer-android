<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1120">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0f172a"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnBackLocTrail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                app:tint="#f8fafc" />

            <TextView
                android:id="@+id/txtLocTrailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnBackLocTrail"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:text="📍 Loc Trail"
                android:textColor="#f8fafc"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- WebView for Leaflet OpenStreetMap -->
        <WebView
            android:id="@+id/webViewLocTrail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0b1120" />

    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlayLocTrail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B1120"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/loadingLogoLocTrail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/loading_icon"
                android:contentDescription="Loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Rendering Movement Map..."
                android:textColor="#38bdf8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
